docker/backend/*.sh text eol=lf
# Preserve the published byte-pinned instruction schema.
data/instruction/record-schema.json -text

# Evidence checksums bind exact file bytes, including test logs.
Evidence/W05/** -text whitespace=cr-at-eol
Evidence/W06/** -text whitespace=cr-at-eol
# Keep the supplied Markdown hard line breaks without changing its bytes.
Evidence/W06/README.md whitespace=-blank-at-eol,cr-at-eol

# W08 manifests bind the same LF text bytes in Windows and Git checkouts.
Evidence/W08/*.md text eol=lf
Evidence/W08/*.csv text eol=lf
Evidence/W08/*.txt text eol=lf
Evidence/W08/*.json text eol=lf

# W09 evidence hashes bind exact bytes, including screenshots and filtered logs.
Evidence/W09/** -text whitespace=cr-at-eol
