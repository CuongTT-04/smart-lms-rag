DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Set true only when the application is served over HTTPS.
JWT_REFRESH_COOKIE_SECURE=false

# Local email appears in backend logs. Set the SMTP backend to send real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OHAYO <noreply@ohayo.local>
PASSWORD_RESET_TIMEOUT=1800
# Development only: bypass email verification. Never enable with real user data.
PASSWORD_RESET_PREVIEW=true
# Trusted frontend URL; the reset page will be implemented separately.
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# SQLite is the local default. For PostgreSQL, set DB_ENGINE to
# django.db.backends.postgresql and provide the remaining values.
# Local SQLite uses backend/db-w2.sqlite3 when DB_NAME is empty.
# To override SQLite, use an absolute file path for DB_NAME.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Docker Compose uses POSTGRES_* rather than the local SQLite DB_* values.
# These defaults are for localhost development only; replace for other environments.
POSTGRES_DB=smart_lms
POSTGRES_USER=smart_lms
POSTGRES_PASSWORD=smart-lms-local-only
POSTGRES_PORT=5432
BACKEND_PORT=8000
