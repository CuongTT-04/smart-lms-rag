DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Set true only when the application is served over HTTPS.
JWT_REFRESH_COOKIE_SECURE=false

# Local email appears in backend logs. Set the SMTP backend to send real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OHAYO <noreply@ohayo.local>
PASSWORD_RESET_TIMEOUT=1800
# Development only: bypass email verification. Never enable with real user data.
PASSWORD_RESET_PREVIEW=true
# Trusted frontend URL; the reset page will be implemented separately.
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Direct local backend and Docker use the same PostgreSQL database.
# Blank DB_NAME/USER/PASSWORD inherit POSTGRES_* below.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# Docker backend uses host database:5432; local backend uses 127.0.0.1:5433.
# These defaults are for localhost development only; replace for other environments.
POSTGRES_DB=smart_lms
POSTGRES_USER=smart_lms
POSTGRES_PASSWORD=smart-lms-local-only
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
# W4 chat: operator-owned paths inside the backend container. Empty = HTTP 503.
# Generator is a dotted Python callable implementing docs/plans/... W4 Contract v1.0.
AI_GENERATOR=
AI_GENERATION_CONFIG=
AI_EMBEDDING_CONFIG=/app/backend/config/ai/embedding.json
AI_INDEX_DIRECTORY=/app/.private/documents/ai/index
# Per-version chunk manifest paths separated by ':' in Linux containers, ';' on Windows.
AI_CATALOG_MANIFESTS=@index
# Kaggle gateway: URL only, no /generate suffix; same secret as OHAYO_INFERENCE_TOKEN.
AI_INFERENCE_URL=
AI_INFERENCE_TOKEN=
