Course "1" -- "1" AccessPolicy : courseId
User "1" -- "0..*" Enrollment : userId
Course "1" -- "0..*" Enrollment : courseId
Course "1" -- "0..*" Lesson : courseId
Course "1" -- "0..*" KnowledgeDocument : courseId
User "1" -- "0..*" KnowledgeDocument : uploadedById
Lesson "1" -- "0..*" LessonDocument : lessonId
KnowledgeDocument "1" -- "0..*" LessonDocument : documentId
