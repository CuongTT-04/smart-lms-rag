{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohayo:w5:instruction-record:v1",
  "title": "OHAYO W5 instruction candidate",
  "$comment": "Design approved according to user report 2026-10-28. Structural validation does not imply peer/content review or public source permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "author_member",
    "course_code",
    "language",
    "task_type",
    "mode",
    "question",
    "contexts",
    "exercise",
    "target_text",
    "source_group_ids",
    "variant_family_id",
    "parent_record_id",
    "provenance",
    "prompt_version",
    "source_identity_scope",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "w5-instruction-v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "author_member": {
      "enum": [
        "A",
        "B"
      ]
    },
    "course_code": {
      "enum": [
        "THMLN",
        "KTCTMLN",
        "CNXHKH",
        "FIXTURE"
      ]
    },
    "language": {
      "const": "vi"
    },
    "task_type": {
      "enum": [
        "qa",
        "summary",
        "hint",
        "insufficient_evidence"
      ]
    },
    "mode": {
      "enum": [
        "qa",
        "hint"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 8000
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "exercise": {
      "anyOf": [
        {
          "$ref": "#/$defs/exercise"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_group_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "variant_family_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "parent_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "prompt_version": {
      "const": "bounded_guidance"
    },
    "source_identity_scope": {
      "enum": [
        "offline_corpus",
        "fixture_only"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "chunk_id",
        "text",
        "document_id",
        "version_id",
        "document_title",
        "page_number",
        "section_title",
        "source_checksum",
        "text_sha256",
        "rights_reference"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "section_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rights_reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_id",
        "question",
        "choices"
      ],
      "properties": {
        "exercise_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "drafting_tool",
        "generation_model_id",
        "generation_model_revision",
        "generation_prompt_sha256",
        "recipe_id",
        "created_at"
      ],
      "properties": {
        "method": {
          "enum": [
            "manual",
            "model_assisted",
            "model_generated"
          ]
        },
        "drafting_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_model_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_prompt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "hint"
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "hint"
          },
          "target_text": {
            "pattern": "^(?:(?:READ|OUTLINE) \\[[1-9][0-9]*\\]|COMPARE \\[[1-9][0-9]*\\] \\[[1-9][0-9]*\\])$"
          }
        }
      },
      "else": {
        "properties": {
          "mode": {
            "const": "qa"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "insufficient_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "target_text": {
            "const": "INSUFFICIENT_EVIDENCE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_identity_scope": {
            "const": "fixture_only"
          }
        }
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^FX_W5_[0-9]{5}$"
          },
          "course_code": {
            "const": "FIXTURE"
          }
        }
      },
      "else": {
        "properties": {
          "record_id": {
            "pattern": "^W5_[AB]_[0-9]{5}$"
          },
          "course_code": {
            "enum": [
              "THMLN",
              "KTCTMLN",
              "CNXHKH"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_identity_scope": {
            "const": "offline_corpus"
          },
          "author_member": {
            "const": "A"
          }
        }
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^W5_A_[0-9]{5}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_identity_scope": {
            "const": "offline_corpus"
          },
          "author_member": {
            "const": "B"
          }
        }
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^W5_B_[0-9]{5}$"
          }
        }
      }
    }
  ]
}
