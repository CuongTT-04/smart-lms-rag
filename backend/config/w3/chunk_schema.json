{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W3 page-local chunk 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chunk_id", "course_id", "document_id", "version_id", "document_title", "page_number", "section_title", "chunk_order", "text", "token_count", "char_start", "char_end", "source_checksum", "chunking_config_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "chunk_id": {"type": "string", "format": "uuid"},
    "course_id": {"type": "string", "format": "uuid"},
    "document_id": {"type": "string", "format": "uuid"},
    "version_id": {"type": "string", "format": "uuid"},
    "document_title": {"type": "string"},
    "page_number": {"type": "integer", "minimum": 1},
    "section_title": {"type": ["string", "null"]},
    "chunk_order": {"type": "integer", "minimum": 0},
    "text": {"type": "string", "minLength": 1},
    "token_count": {"type": "integer", "minimum": 1},
    "char_start": {"type": "integer", "minimum": 0},
    "char_end": {"type": "integer", "minimum": 1},
    "source_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chunking_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
