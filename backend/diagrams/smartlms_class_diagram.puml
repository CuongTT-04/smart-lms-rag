' =========================
' Relationships
' =========================

User "1" *-- "0..1" StudentProfile
User "1" *-- "0..1" TeacherProfile
User "1" -- "0..*" CourseMember
User "1" -- "0..*" AuditLog
User "1" -- "0..*" Notification

Course "1" -- "0..*" CourseMember
Course "1" *-- "0..*" Classroom
Course "1" *-- "0..*" Lesson
Course "1" *-- "1" AccessPolicy
Course "1" *-- "1" RAGConfiguration

Classroom "1" -- "0..*" Enrollment
Course "1" -- "0..*" Enrollment
StudentProfile "1" -- "0..*" Enrollment

Lesson "1" *-- "0..*" LessonContent
Lesson "1" -- "0..*" LessonProgress
StudentProfile "1" -- "0..*" LessonProgress
LessonContent "1" -- "0..1" Video
Video "1" *-- "0..*" InteractiveCheckpoint
Video "1" -- "0..*" VideoProgress
Video "1" -- "0..*" VideoEvent
StudentProfile "1" -- "0..*" VideoProgress
StudentProfile "1" -- "0..*" VideoEvent
InteractiveCheckpoint "1" -- "0..*" VideoCheckpointAttempt
StudentProfile "1" -- "0..*" VideoCheckpointAttempt

Course "1" *-- "0..*" KnowledgeDocument
KnowledgeDocument "0..*" -- "1" User : uploadedBy
KnowledgeDocument "1" *-- "1..*" DocumentVersion
KnowledgeDocument "0..1" -- "0..*" KnowledgeDocument : replaces
DocumentVersion "1" *-- "0..*" DocumentProcessingJob
DocumentVersion "1" *-- "0..*" DocumentPage
DocumentVersion "1" *-- "0..*" DocumentChunk
DocumentPage "1" -- "0..*" DocumentChunk

AIConversation "0..*" -- "1" StudentProfile
AIConversation "0..*" -- "1" Course
AIConversation "1" *-- "0..*" AIMessage
AIConversation "1" *-- "1" AIConversationScope
AIConversationScope "0..*" -- "0..1" Lesson
AIConversationScope "0..*" -- "0..*" KnowledgeDocument
AIMessage "1" *-- "0..1" AIResponse
AIResponse "1" *-- "0..*" SourceCitation
AIResponse "0..*" -- "1" AIModel
AIResponse "0..*" -- "0..1" LoRAAdapter
SourceCitation "0..*" -- "1" KnowledgeDocument
SourceCitation "0..*" -- "1" DocumentVersion
SourceCitation "0..*" -- "1" DocumentChunk
AIUsageLog "0..*" -- "1" User
AIUsageLog "0..*" -- "0..1" Course
AIModel "1" *-- "0..*" LoRAAdapter
AIExperiment "0..*" -- "1" AIModel
AIExperiment "0..*" -- "0..1" LoRAAdapter

Course "1" -- "0..*" Quiz
Lesson "0..1" -- "0..*" Quiz
Quiz "1" *-- "1..*" Question
Quiz "1" *-- "1" AssessmentPolicy
Question "1" *-- "0..*" QuestionOption
QuizAttempt "0..*" -- "1" Quiz
QuizAttempt "0..*" -- "1" StudentProfile
QuizAttempt "1" *-- "0..*" Answer
Answer "0..*" -- "1" Question
Answer "0..*" -- "0..1" QuestionOption

Course "1" -- "0..*" Assignment
Lesson "0..1" -- "0..*" Assignment
Assignment "1" *-- "1" AssessmentPolicy
Assignment "1" *-- "0..*" AssignmentSubmission
AssignmentSubmission "0..*" -- "1" StudentProfile
AssignmentSubmission "0..*" -- "0..1" User : gradedBy

Order "0..*" -- "1" StudentProfile
Order "1" *-- "1..*" OrderItem
OrderItem "0..*" -- "1" Course
Order "1" *-- "0..*" PaymentTransaction
PaymentTransaction "1" -- "0..*" Refund

QuotaUsage "0..*" -- "0..1" User
QuotaUsage "0..*" -- "0..1" Course

@enduml
