@startuml
title Smart LMS RAG - Complete Class Diagram

skinparam classAttributeIconSize 0
hide circle

' =========================
' Enums
' =========================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CourseRole {
  OWNER
  TEACHER
  ASSISTANT
  STUDENT
}

note right of CourseRole
  W2: each course has one teacher OWNER.
  Only OWNER and STUDENT memberships are supported.
  TEACHER / ASSISTANT are legacy REMOVED records only.
end note

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum AccessType {
  FREE
  PAID
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  TEXT
  DOCUMENT
  VIDEO
  QUIZ
  ASSIGNMENT
}

enum DocumentType {
  PDF
  DOCX
  PPTX
  TXT
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  REMOVED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum DocumentVisibility {
  PROTECTED
  PUBLIC_CLEAN
}

enum DownloadPolicy {
  VIEW_ONLY
  ALLOW_DOWNLOAD
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIMode {
  QA
  HINT
  SUMMARY
}

enum AIProviderType {
  LOCAL
  OPENAI_COMPATIBLE
  COLAB_SERVICE
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  REFUNDED
}

enum VideoEventType {
  PLAY
  PAUSE
  SEEK
  CHECKPOINT_ANSWERED
  COMPLETED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  GRANT_ACCESS
  REVOKE_ACCESS
  PROCESS_DOCUMENT
  PAYMENT_CALLBACK
  AI_REQUEST
}

' =========================
' Identity and access
' =========================

package "apps.users" {
  class User {
    - id: UUID
    - username: String
    - email: String
    - passwordHash: String
    - fullName: String
    - avatarUrl: String
    - phone: String
    - role: UserRole
    - status: UserStatus
    - createdAt: DateTime
    - updatedAt: DateTime
    - lastLoginAt: DateTime
  }

  class StudentProfile {
    - id: UUID
    - learningGoal: String
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  class TeacherProfile {
    - id: UUID
    - bio: String
    - specialization: String
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  note right of User
    Django mappings:
    passwordHash -> password (hashed, never returned)
    createdAt -> date_joined
    lastLoginAt -> last_login
    Other fields use snake_case.
    Registration requires STUDENT or TEACHER and creates an ACTIVE user.
    Subsequent role changes are database-only for now.
    Only the profile matching the selected role is provisioned and returned;
    permissions are determined by role, not profile existence.
  end note
}

' =========================
' Courses and enrollment
' =========================

package "apps.courses" {
  class Course {
    - id: UUID
    - title: String
    - description: Text
    - thumbnailUrl: String
    - status: CourseStatus
    - visibility: Visibility
    - accessType: AccessType
    - price: Decimal
    - createdAt: DateTime
    - updatedAt: DateTime
    - publishedAt: DateTime
  }

  class Classroom {
    - id: UUID
    - name: String
    - classCode: String
    - passwordHash: String
    - visibility: Visibility
    - accessType: AccessType
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  class AccessPolicy {
    - id: UUID
    - visibility: Visibility
    - accessType: AccessType
    - price: Decimal
    - requireClassCode: Boolean
    - requirePassword: Boolean
    - requirePayment: Boolean
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  class CourseMember {
    - id: UUID
    - role: CourseRole
    - status: MemberStatus
    - joinedAt: DateTime
    - removedAt: DateTime
  }

  class Enrollment {
    - id: UUID
    - enrolledAt: DateTime
    - status: MemberStatus
    - progressPercent: Float
    - completedAt: DateTime
  }
}

' =========================
' Learning content
' =========================

package "apps.learning" {
  class Lesson {
    - id: UUID
    - title: String
    - description: Text
    - orderIndex: Integer
    - status: LessonStatus
    - createdAt: DateTime
    - updatedAt: DateTime
    - publishedAt: DateTime
  }

  class LessonContent {
    - id: UUID
    - contentType: ContentType
    - title: String
    - body: Text
    - orderIndex: Integer
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  class LessonProgress {
    - id: UUID
    - progressPercent: Float
    - lastPosition: Integer
    - completed: Boolean
    - completedAt: DateTime
    - updatedAt: DateTime
  }

  class Video {
    - id: UUID
    - storagePath: String
    - videoUrl: String
    - duration: Integer
    - thumbnailUrl: String
    - version: Integer
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  class InteractiveCheckpoint {
    - id: UUID
    - timestamp: Integer
    - questionText: Text
    - type: QuestionType
    - hintText: Text
    - rewindOnWrong: Boolean
    - rewindTimestamp: Integer
    - orderIndex: Integer
  }

  class VideoProgress {
    - id: UUID
    - lastPosition: Integer
    - watchedSeconds: Integer
    - completed: Boolean
    - completedAt: DateTime
    - updatedAt: DateTime
  }

  class VideoCheckpointAttempt {
    - id: UUID
    - selectedOptionId: UUID
    - textAnswer: Text
    - isCorrect: Boolean
    - answeredAt: DateTime
  }

  class VideoEvent {
    - id: UUID
    - eventType: VideoEventType
    - position: Integer
    - idempotencyKey: String
    - createdAt: DateTime
  }
}

' =========================
' Documents and ingestion
' =========================

package "apps.documents" {
  class KnowledgeDocument {
    - id: UUID
    - title: String
    - originalFileName: String
    - fileType: DocumentType
    - mimeType: String
    - fileSize: Long
    - checksum: String
    - status: DocumentStatus
    - visibility: DocumentVisibility
    - downloadPolicy: DownloadPolicy
    - watermarkEnabled: Boolean
    - activeVersionNumber: Integer
    - uploadedAt: DateTime
    - removedAt: DateTime
  }

  class DocumentVersion {
    - id: UUID
    - versionNumber: Integer
    - storagePath: String
    - protectedStoragePath: String
    - publicStoragePath: String
    - checksum: String
    - pageCount: Integer
    - parserName: String
    - parserVersion: String
    - ocrStatus: String
    - language: String
    - status: DocumentStatus
    - processingError: Text
    - createdAt: DateTime
    - processedAt: DateTime
  }

  class DocumentProcessingJob {
    - id: UUID
    - status: ProcessingJobStatus
    - jobType: String
    - startedAt: DateTime
    - finishedAt: DateTime
    - retryCount: Integer
    - errorMessage: Text
    - workerName: String
  }

  class DocumentPage {
    - id: UUID
    - pageNumber: Integer
    - rawText: Text
    - normalizedText: Text
    - extractionQuality: Float
    - createdAt: DateTime
  }

  class DocumentChunk {
    - id: UUID
    - chunkIndex: Integer
    - content: Text
    - normalizedContent: Text
    - pageNumberStart: Integer
    - pageNumberEnd: Integer
    - startOffset: Integer
    - endOffset: Integer
    - vectorId: String
    - tokenCount: Integer
    - createdAt: DateTime
  }
}

' =========================
' AI and RAG
' =========================

package "apps.ai" {
  class RAGConfiguration {
    - id: UUID
    - embeddingModel: String
    - vectorStoreType: String
    - similarityThreshold: Float
    - topK: Integer
    - chunkSize: Integer
    - chunkOverlap: Integer
    - rerankerModel: String
    - enabled: Boolean
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  class AIModel {
    - id: UUID
    - name: String
    - version: String
    - providerType: AIProviderType
    - modelType: String
    - contextWindow: Integer
    - isActive: Boolean
    - createdAt: DateTime
  }

  class LoRAAdapter {
    - id: UUID
    - name: String
    - version: String
    - filePath: String
    - datasetVersion: String
    - enabled: Boolean
    - createdAt: DateTime
  }

  class AIConversation {
    - id: UUID
    - mode: AIMode
    - title: String
    - deletedAt: DateTime
    - createdAt: DateTime
    - updatedAt: DateTime
  }

  class AIConversationScope {
    - id: UUID
    - mode: AIMode
    - includeGeneralSource: Boolean
    - createdAt: DateTime
  }

  class AIMessage {
    - id: UUID
    - role: MessageRole
    - content: Text
    - tokenCount: Integer
    - createdAt: DateTime
  }

  class AIResponse {
    - id: UUID
    - confidenceScore: Float
    - similarityScore: Float
    - isRefused: Boolean
    - refusalReason: Text
    - modelName: String
    - promptTokens: Integer
    - completionTokens: Integer
    - latencyMs: Integer
    - createdAt: DateTime
  }

  class SourceCitation {
    - id: UUID
    - pageNumber: Integer
    - startOffset: Integer
    - endOffset: Integer
    - snippet: Text
    - relevanceScore: Float
    - documentVersionNumber: Integer
    - createdAt: DateTime
  }

  class AIUsageLog {
    - id: UUID
    - requestId: String
    - mode: AIMode
    - modelName: String
    - promptTokens: Integer
    - completionTokens: Integer
    - latencyMs: Integer
    - success: Boolean
    - errorMessage: Text
    - createdAt: DateTime
  }

  class AIExperiment {
    - id: UUID
    - name: String
    - description: Text
    - enabled: Boolean
    - trafficPercent: Float
    - startedAt: DateTime
    - endedAt: DateTime
  }
}

' =========================
' Assessments
' =========================

package "apps.assessments" {
  class AssessmentPolicy {
